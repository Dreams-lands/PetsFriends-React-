# Chọn 1 trong 2 cách kết nối SQL Server:

# --- Cách 1: Windows Authentication (khuyên dùng trên máy Windows) ---
DB_AUTH=windows
DB_SERVER=localhost
DB_NAME=QLThuCung

# --- Cách 2: SQL Server Authentication (sa) ---
# DB_AUTH=sql
# DB_SERVER=localhost
# DB_PORT=1433
# DB_NAME=QLThuCung
# DB_USER=sa
# DB_PASSWORD=your_sa_password
